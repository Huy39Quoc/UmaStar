# Copy file này thành .env và điền giá trị thực tế cho môi trường của bạn
APP_NAME=
SERVER_PORT=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JPA / Hibernate (update | validate | none | create | create-drop)
JPA_DDL_AUTO=
JPA_SHOW_SQL=
JPA_FORMAT_SQL=

# Swagger / OpenAPI
SWAGGER_API_DOCS_PATH=
SWAGGER_UI_PATH=

CORS_ALLOWED_ORIGINS=

# JWT (tạo secret: openssl rand -base64 48, tối thiểu 32 ký tự)
JWT_SECRET=
JWT_ACCESS_EXP_MS=
JWT_REFRESH_EXP_MS=
RESET_TOKEN_EXP_MS=
RESET_COOLDOWN_MS=

# Upload file & Storage (STORAGE_PROVIDER: local | cloudinary)
MAX_FILE_SIZE=
MAX_REQUEST_SIZE=
STORAGE_PROVIDER=
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Tài khoản mặc định theo từng Role (chỉ dùng cho môi trường dev; production chỉ cần cấu hình MANAGER)
# 1. LOGISTICS_MANAGER - Quản lý Điều hành Logistics (duyệt đơn, lập kế hoạch chuyến, xem báo cáo)
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

# 2. TRANSPORT_SPECIALIST - Chuyên viên Thủ tục & Kiểm dịch (quản lý quy định, duyệt hồ sơ pháp lý)
SEED_SPECIALIST_EMAIL=
SEED_SPECIALIST_PASSWORD=

# 3. FLEET_COORDINATOR - Điều phối viên Đội xe & Lộ trình (quản lý xe, điểm dừng, xử lý sự cố)
SEED_COORDINATOR_EMAIL=
SEED_COORDINATOR_PASSWORD=

# 4. DRIVER - Tài xế vận chuyển (xem chuyến được giao, báo cáo mốc lộ trình, sự cố, bàn giao)
SEED_DRIVER_EMAIL=
SEED_DRIVER_PASSWORD=

# 5. ESCORT - Nhân viên đi kèm chăm sóc ngựa (ghi nhận nhật ký sức khỏe ngựa trên chuyến)
SEED_ESCORT_EMAIL=
SEED_ESCORT_PASSWORD=

# 6. CUSTOMER - Khách hàng CLB / Chủ ngựa (tạo hồ sơ ngựa, đặt đơn, tải giấy tờ, theo dõi & nghiệm thu)
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
