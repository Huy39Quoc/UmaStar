# Copy file này thành .env và điền giá trị thực tế cho môi trường của bạn
APP_NAME=
SERVER_PORT=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JPA / Hibernate (update | validate | none | create | create-drop)
JPA_DDL_AUTO=
JPA_SHOW_SQL=
JPA_FORMAT_SQL=

# Swagger / OpenAPI
SWAGGER_API_DOCS_PATH=
SWAGGER_UI_PATH=

# JWT (tạo secret: openssl rand -base64 48, tối thiểu 32 ký tự)
JWT_SECRET=
JWT_ACCESS_EXP_MS=
JWT_REFRESH_EXP_MS=

# Upload file
MAX_FILE_SIZE=
MAX_REQUEST_SIZE=
UPLOAD_DIR=

# Tài khoản Manager đầu tiên
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
